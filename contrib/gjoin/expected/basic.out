CREATE TABLE t1 (a INT, b INT);
CREATE TABLE t2 (c INT, d INT);
INSERT INTO t1 SELECT i, mod(i * 7121, 1000) FROM generate_series(1,10000) s(i);
INSERT INTO t2 SELECT i, mod(i * 5443, 1000) FROM generate_series(1,10000) s(i);
VACUUM ANALYZE t1;
VACUUM ANALYZE t2;
LOAD 'gjoin';
SET gjoin.enabled = true;
EXPLAIN (VERBOSE, COSTS OFF, BUFFERS OFF) SELECT * FROM t1 JOIN t2 ON (t1.a = t2.c);
            QUERY PLAN            
----------------------------------
 Custom Join (GJoin) Join
   Output: t1.a, t1.b, t2.c, t2.d
   Join Cond: (t1.a = t2.c)
   Runs: inner=0 outer=0
   Memory: inner=0 outer=0
   ->  Seq Scan on public.t1
         Output: t1.a, t1.b
   ->  Seq Scan on public.t2
         Output: t2.c, t2.d
(9 rows)

EXPLAIN (VERBOSE, ANALYZE, COSTS OFF, TIMING OFF, BUFFERS OFF, SUMMARY OFF) SELECT * FROM t1 JOIN t2 ON (t1.a = t2.c) LIMIT 100;
                            QUERY PLAN                            
------------------------------------------------------------------
 Limit (actual rows=100.00 loops=1)
   Output: t1.a, t1.b, t2.c, t2.d
