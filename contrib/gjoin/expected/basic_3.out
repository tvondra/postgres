CREATE TABLE t1 (a INT, b INT, c INT);
CREATE TABLE t2 (d INT, e INT, f INT);
CREATE TABLE t3 (g INT, h INT, i INT);
INSERT INTO t1 SELECT i, i, mod(i * 7121, 1000) FROM generate_series(1,10000) s(i);
INSERT INTO t2 SELECT i, i, mod(i * 5443, 1000) FROM generate_series(1,10000) s(i);
INSERT INTO t3 SELECT i, i, mod(i * 5441, 1000) FROM generate_series(1,10000) s(i);
VACUUM ANALYZE t1;
VACUUM ANALYZE t2;
VACUUM ANALYZE t3;
LOAD 'gjoin';
SET gjoin.enabled = true;
EXPLAIN (VERBOSE, COSTS OFF, BUFFERS OFF) SELECT * FROM t1 JOIN t2 ON (t1.a = t2.d) JOIN t3 ON (t1.b = t3.g);
                           QUERY PLAN                           
----------------------------------------------------------------
 Custom Join (GJoin) Join
   Output: t1.a, t1.b, t1.c, t2.d, t2.e, t2.f, t3.g, t3.h, t3.i
   Join Cond: (t1.b = t3.g)
   ->  Custom Join (GJoin) Join
         Output: t1.a, t1.b, t1.c, t2.d, t2.e, t2.f
         Join Cond: (t1.a = t2.d)
         ->  Seq Scan on public.t1
               Output: t1.a, t1.b, t1.c
         ->  Seq Scan on public.t2
               Output: t2.d, t2.e, t2.f
   ->  Seq Scan on public.t3
         Output: t3.g, t3.h, t3.i
(12 rows)

