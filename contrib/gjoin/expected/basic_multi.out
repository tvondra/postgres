CREATE TABLE t1 (a1 INT, a2 INT, a3 INT);
CREATE TABLE t2 (b1 INT, b2 INT, b3 INT);
INSERT INTO t1 SELECT mod(i, 31), mod(i, 47), mod(i * 7121, 1000) FROM generate_series(1,10000) s(i);
INSERT INTO t2 SELECT mod(i, 37), mod(i, 41), mod(i * 5443, 1000) FROM generate_series(1,10000) s(i);
VACUUM ANALYZE t1;
VACUUM ANALYZE t2;
LOAD 'gjoin';
SET gjoin.enabled = true;
EXPLAIN (VERBOSE, COSTS OFF, BUFFERS OFF) SELECT * FROM t1 JOIN t2 ON (t1.a1 = t2.b1 AND t1.a2 = t2.b2);
                     QUERY PLAN                     
----------------------------------------------------
 Custom Join (GJoin) Join
   Output: t1.a1, t1.a2, t1.a3, t2.b1, t2.b2, t2.b3
   Join Cond: (t1.a1 = t2.b1), (t1.a2 = t2.b2)
   ->  Seq Scan on public.t1
         Output: t1.a1, t1.a2, t1.a3
   ->  Seq Scan on public.t2
         Output: t2.b1, t2.b2, t2.b3
(7 rows)

