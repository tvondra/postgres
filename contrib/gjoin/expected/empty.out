CREATE TABLE t1 (a INT, b INT);
CREATE TABLE t2 (c INT, d INT);
CREATE TABLE t3 (e INT, f INT);
VACUUM ANALYZE t1;
VACUUM ANALYZE t2;
VACUUM ANALYZE t3;
LOAD 'gjoin';
SET gjoin.enabled = true;
EXPLAIN (VERBOSE, ANALYZE, COSTS OFF, TIMING OFF, BUFFERS OFF, SUMMARY OFF) SELECT * FROM t1 JOIN t2 ON (t1.a = t2.c);
                       QUERY PLAN                       
--------------------------------------------------------
 Nested Loop (actual rows=0.00 loops=1)
   Output: t1.a, t1.b, t2.c, t2.d
   Join Filter: (t1.a = t2.c)
   ->  Seq Scan on public.t1 (actual rows=0.00 loops=1)
         Output: t1.a, t1.b
   ->  Seq Scan on public.t2 (never executed)
         Output: t2.c, t2.d
(7 rows)

EXPLAIN (VERBOSE, ANALYZE, COSTS OFF, TIMING OFF, BUFFERS OFF, SUMMARY OFF) SELECT * FROM t1 JOIN t2 ON (t1.a = t2.c) JOIN t3 ON (t1.b = t3.e);
                          QUERY PLAN                          
--------------------------------------------------------------
 Nested Loop (actual rows=0.00 loops=1)
   Output: t1.a, t1.b, t2.c, t2.d, t3.e, t3.f
   Join Filter: (t1.b = t3.e)
   ->  Nested Loop (actual rows=0.00 loops=1)
         Output: t1.a, t1.b, t2.c, t2.d
         Join Filter: (t1.a = t2.c)
         ->  Seq Scan on public.t1 (actual rows=0.00 loops=1)
               Output: t1.a, t1.b
         ->  Seq Scan on public.t2 (never executed)
               Output: t2.c, t2.d
   ->  Seq Scan on public.t3 (never executed)
         Output: t3.e, t3.f
(12 rows)

