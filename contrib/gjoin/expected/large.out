CREATE TABLE t1 (a INT, b INT);
CREATE TABLE t2 (c INT, d INT);
INSERT INTO t1 SELECT i, mod(i * 701, 1000) FROM generate_series(1,1000000) s(i);
INSERT INTO t2 SELECT i, mod(i * 953, 1000) FROM generate_series(1,1000000) s(i);
VACUUM ANALYZE t1;
VACUUM ANALYZE t2;
LOAD 'gjoin';
SET gjoin.enabled = true;
SET work_mem = '128kB';
EXPLAIN (VERBOSE, COSTS OFF, BUFFERS OFF) SELECT * FROM t1 JOIN t2 ON (t1.a = t2.c);
            QUERY PLAN            
----------------------------------
 Custom Join (GJoin) Join
   Output: t1.a, t1.b, t2.c, t2.d
   Join Cond: (t1.a = t2.c)
   ->  Seq Scan on public.t1
         Output: t1.a, t1.b
   ->  Seq Scan on public.t2
         Output: t2.c, t2.d
(7 rows)

