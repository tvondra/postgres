-- ===========================================================================
-- A 7-relation query mixing FULL JOINs and a LATERAL join whose flattened
-- 6-way sub-problem the lindp join_search_hook cannot linearize, so it falls
-- back to standard_join_search.  Run against a server with the `lindp` module.
-- ===========================================================================
LOAD 'lindp';
SET lindp.enabled        = on;
SET lindp.fallback       = off;  -- error out if linearization failed
SET lindp.min_relations  = 3;    -- low, so a 6-way join uses LinDP (not GEQO/DP)
SET lindp.seeds          = 1;    -- try every IKKBZ root
SET geqo                       = off;
SET join_collapse_limit        = 100;   -- keep the whole join flat (one search problem)
SET from_collapse_limit        = 100;
DROP TABLE IF EXISTS la, lb, lc, ld, le, lf, lg CASCADE;
NOTICE:  table "la" does not exist, skipping
NOTICE:  table "lb" does not exist, skipping
NOTICE:  table "lc" does not exist, skipping
NOTICE:  table "ld" does not exist, skipping
NOTICE:  table "le" does not exist, skipping
NOTICE:  table "lf" does not exist, skipping
NOTICE:  table "lg" does not exist, skipping
CREATE TABLE la (id int, x int, y int);
CREATE TABLE lb (id int, x int, y int);
CREATE TABLE lc (id int, x int, y int);
CREATE TABLE ld (id int, x int, y int);
CREATE TABLE le (id int, x int, y int);
CREATE TABLE lf (id int, x int, y int);
CREATE TABLE lg (id int, x int, y int);
-- Skewed cardinalities make IKKBZ's C_out order disagree with the order the
-- FULL JOIN chain forces.
INSERT INTO la SELECT g,g,g FROM generate_series(1,5)      g;
INSERT INTO lb SELECT g,g,g FROM generate_series(1,80000)  g;
INSERT INTO lc SELECT g,g,g FROM generate_series(1,90000)  g;
INSERT INTO ld SELECT g,g,g FROM generate_series(1,6)      g;
INSERT INTO le SELECT g,g,g FROM generate_series(1,120000) g;
INSERT INTO lf SELECT g,g,g FROM generate_series(1,3)      g;
INSERT INTO lg SELECT g,g,g FROM generate_series(1,4)      g;
ANALYZE;
-- The LATERAL join (ld correlated to lc) sits inside a left-deep chain of
-- FULL JOINs.  The whole left-deep tree flattens into ONE 6-way join-search
-- problem; the outer-join ordering constraints make the IKKBZ linear order
-- non-realizable as contiguous intervals, so lindp_interval_dp() returns NULL
-- and the module falls back to standard_join_search.
EXPLAIN (COSTS OFF)
SELECT *
FROM (((((( la FULL JOIN lb ON lb.y = la.y)
               FULL JOIN lc ON lc.x = la.x)
               JOIN LATERAL (SELECT * FROM ld WHERE ld.x = lc.x) ld ON true)
               FULL JOIN le ON le.y = lb.y)
               JOIN lf ON lf.x = le.x)
               FULL JOIN lg ON lg.y = lf.y);
                              QUERY PLAN                              
----------------------------------------------------------------------
 Hash Full Join
   Hash Cond: (lf.y = lg.y)
   ->  Hash Join
         Hash Cond: (le.x = lf.x)
         ->  Hash Left Join
               Hash Cond: (le.y = lb.y)
               ->  Seq Scan on le
               ->  Hash
                     ->  Hash Join
                           Hash Cond: (lc.x = ld.x)
                           ->  Hash Left Join
                                 Hash Cond: (lb.y = la.y)
                                 ->  Seq Scan on lb
                                 ->  Hash
                                       ->  Hash Right Join
                                             Hash Cond: (lc.x = la.x)
                                             ->  Seq Scan on lc
                                             ->  Hash
                                                   ->  Seq Scan on la
                           ->  Hash
                                 ->  Seq Scan on ld
         ->  Hash
               ->  Seq Scan on lf
   ->  Hash
         ->  Seq Scan on lg
(25 rows)

-- Correctness: the fallback plan matches the default search (both return 4).
SET lindp.enabled = on;
SET lindp.fallback = on;
EXPLAIN (COSTS OFF)
SELECT *
FROM (((((( la FULL JOIN lb ON lb.y = la.y)
               FULL JOIN lc ON lc.x = la.x)
               JOIN LATERAL (SELECT * FROM ld WHERE ld.x = lc.x) ld ON true)
               FULL JOIN le ON le.y = lb.y)
               JOIN lf ON lf.x = le.x)
               FULL JOIN lg ON lg.y = lf.y);
                              QUERY PLAN                              
----------------------------------------------------------------------
 Hash Full Join
   Hash Cond: (lf.y = lg.y)
   ->  Hash Join
         Hash Cond: (le.x = lf.x)
         ->  Hash Left Join
               Hash Cond: (le.y = lb.y)
               ->  Seq Scan on le
               ->  Hash
                     ->  Hash Join
                           Hash Cond: (lc.x = ld.x)
                           ->  Hash Left Join
                                 Hash Cond: (lb.y = la.y)
                                 ->  Seq Scan on lb
                                 ->  Hash
                                       ->  Hash Right Join
                                             Hash Cond: (lc.x = la.x)
                                             ->  Seq Scan on lc
                                             ->  Hash
                                                   ->  Seq Scan on la
                           ->  Hash
                                 ->  Seq Scan on ld
         ->  Hash
               ->  Seq Scan on lf
   ->  Hash
         ->  Seq Scan on lg
(25 rows)

SET lindp.enabled = off;
EXPLAIN (COSTS OFF)
SELECT *
FROM (((((( la FULL JOIN lb ON lb.y = la.y)
               FULL JOIN lc ON lc.x = la.x)
               JOIN LATERAL (SELECT * FROM ld WHERE ld.x = lc.x) ld ON true)
               FULL JOIN le ON le.y = lb.y)
               JOIN lf ON lf.x = le.x)
               FULL JOIN lg ON lg.y = lf.y);
                           QUERY PLAN                           
----------------------------------------------------------------
 Hash Full Join
   Hash Cond: (lf.y = lg.y)
   ->  Nested Loop Left Join
         Join Filter: (le.y = lb.y)
         ->  Hash Join
               Hash Cond: (le.x = lf.x)
               ->  Seq Scan on le
               ->  Hash
                     ->  Seq Scan on lf
         ->  Materialize
               ->  Hash Join
                     Hash Cond: (lc.x = ld.x)
                     ->  Hash Left Join
                           Hash Cond: (lb.y = la.y)
                           ->  Seq Scan on lb
                           ->  Hash
                                 ->  Hash Right Join
                                       Hash Cond: (lc.x = la.x)
                                       ->  Seq Scan on lc
                                       ->  Hash
                                             ->  Seq Scan on la
                     ->  Hash
                           ->  Seq Scan on ld
   ->  Hash
         ->  Seq Scan on lg
(25 rows)

DROP TABLE la, lb, lc, ld, le, lf, lg CASCADE;
