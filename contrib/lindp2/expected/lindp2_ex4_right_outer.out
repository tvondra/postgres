--
-- Example 4: a star of inner joins with a single RIGHT JOIN (no LATERAL)
--
-- A self-contained test case that builds its own tables and runs a star-shaped
-- query: a hub relation is inner-joined to three small "dimension" relations
-- and then RIGHT JOINed to a second large relation.  No LATERAL is involved --
-- the only non-inner join is the single RIGHT JOIN.  With this data the
-- selectivity-driven IKKBZ linear order threads the small inner relations in
-- between the two large relations that the RIGHT JOIN must keep on opposite
-- sides, so no contiguous (window = 0) split of the linear order is a legal
-- join.  The pure-interval DP therefore cannot build the top join relation and
-- the module falls back to standard_join_search() for the component, which
-- still returns a correct plan.
--
-- The test verifies that, despite engaging the fallback, the LinDP++ search
-- returns exactly the same rows the standard dynamic-programming join search
-- would.
--
LOAD 'lindp2';
-- Make the search engage on modestly sized joins and stay deterministic.
SET lindp2.enabled = on;
SET lindp2.fallback = false;
SET lindp2.min_threshold = 3;
SET lindp2.max_threshold = 100;
SET lindp2.window_size = 0;
SET lindp2.adaptive = off;
SET lindp2.seeds = 1;
SET geqo = off;
-- Tables wired up with join keys.  The skewed row counts (two large relations
-- and three small inner relations) are what drive the IKKBZ order into the
-- shape that defeats the contiguous-interval DP.
CREATE TABLE ex4_t1 (id int, k int, v int);
CREATE TABLE ex4_t2 (id int, k int, v int);
CREATE TABLE ex4_t3 (id int, k int, v int);
CREATE TABLE ex4_t4 (id int, k int, v int);
CREATE TABLE ex4_t5 (id int, k int, v int);
INSERT INTO ex4_t1 SELECT g, g % 500, g FROM generate_series(0, 999) g;
INSERT INTO ex4_t2 SELECT g, g % 2,   g FROM generate_series(0, 4)   g;
INSERT INTO ex4_t3 SELECT g, g % 2,   g FROM generate_series(0, 4)   g;
INSERT INTO ex4_t4 SELECT g, g % 2,   g FROM generate_series(0, 4)   g;
INSERT INTO ex4_t5 SELECT g, g % 500, g FROM generate_series(0, 999) g;
ANALYZE ex4_t1, ex4_t2, ex4_t3, ex4_t4, ex4_t5;
-- The example query: an inner-join star with a single RIGHT JOIN mixed in.
EXPLAIN (COSTS OFF)
SELECT ex4_t1.id AS t1, ex4_t2.id AS t2, ex4_t3.id AS t3,
       ex4_t4.id AS t4, ex4_t5.id AS t5
FROM ex4_t1
    JOIN ex4_t2 ON ex4_t2.id = ex4_t1.id
    JOIN ex4_t3 ON ex4_t3.id = ex4_t1.id
    JOIN ex4_t4 ON ex4_t4.id = ex4_t1.id
    RIGHT JOIN ex4_t5 ON ex4_t5.id = ex4_t1.id;
ERROR:  LinDP linearization failed to find a valid plan (5 rels)
-- Show a deterministic slice of the actual result for illustration.
EXPLAIN (COSTS OFF)
SELECT ex4_t1.id AS t1, ex4_t2.id AS t2, ex4_t3.id AS t3,
       ex4_t4.id AS t4, ex4_t5.id AS t5
FROM ex4_t1
    JOIN ex4_t2 ON ex4_t2.id = ex4_t1.id
    JOIN ex4_t3 ON ex4_t3.id = ex4_t1.id
    JOIN ex4_t4 ON ex4_t4.id = ex4_t1.id
    RIGHT JOIN ex4_t5 ON ex4_t5.id = ex4_t1.id
ORDER BY t5
LIMIT 5;
ERROR:  LinDP linearization failed to find a valid plan (5 rels)
DROP TABLE ex4_t1, ex4_t2, ex4_t3, ex4_t4, ex4_t5;
