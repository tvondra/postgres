                     Batches: 1  Memory Usage: 32kB
                     ->  Hash Join (actual rows=20000.00 loops=1)
                           Hash Cond: (hf.d3 = h3.id)
                           ->  Hash Join (actual rows=20000.00 loops=1)
                                 Hash Cond: (hf.d2 = h2.id)
                                 ->  Seq Scan on starjoin_eager_hf hf (actual rows=20000.00 loops=1)
                                 ->  Hash (actual rows=10000.00 loops=1)
                                       Buckets: 16384  Batches: 1  Memory Usage: 480kB
                                       ->  Seq Scan on starjoin_eager_h2 h2 (actual rows=10000.00 loops=1)
                           ->  Hash (actual rows=10000.00 loops=1)
                                 Buckets: 16384  Batches: 1  Memory Usage: 480kB
                                 ->  Seq Scan on starjoin_eager_h3 h3 (actual rows=10000.00 loops=1)
               ->  Hash (actual rows=100.00 loops=1)
                     Buckets: 1024  Batches: 1  Memory Usage: 12kB
                     ->  Seq Scan on starjoin_eager_h1 h1 (actual rows=100.00 loops=1)
(24 rows)

-- same query, h1 written last in FROM, GUC off
SET enable_starjoin_ordering = off;
EXPLAIN (ANALYZE, COSTS OFF, TIMING OFF, BUFFERS OFF, SUMMARY OFF)
SELECT h1.v, sum(hf.x)
FROM starjoin_eager_hf AS hf JOIN starjoin_eager_h2 AS h2 ON hf.d2 = h2.id
                             JOIN starjoin_eager_h3 AS h3 ON hf.d3 = h3.id
                             JOIN starjoin_eager_h1 AS h1 ON hf.d1 = h1.id
GROUP BY h1.v;
                                                QUERY PLAN                                                 
-----------------------------------------------------------------------------------------------------------
 Finalize GroupAggregate (actual rows=10.00 loops=1)
   Group Key: h1.v
   ->  Sort (actual rows=100.00 loops=1)
         Sort Key: h1.v
         Sort Method: quicksort  Memory: 28kB
         ->  Hash Join (actual rows=100.00 loops=1)
               Hash Cond: (hf.d1 = h1.id)
               ->  Partial HashAggregate (actual rows=100.00 loops=1)
                     Group Key: hf.d1
                     Batches: 1  Memory Usage: 32kB
                     ->  Hash Join (actual rows=20000.00 loops=1)
                           Hash Cond: (hf.d3 = h3.id)
                           ->  Hash Join (actual rows=20000.00 loops=1)
                                 Hash Cond: (hf.d2 = h2.id)
                                 ->  Seq Scan on starjoin_eager_hf hf (actual rows=20000.00 loops=1)
                                 ->  Hash (actual rows=10000.00 loops=1)
                                       Buckets: 16384  Batches: 1  Memory Usage: 480kB
