SELECT h1.v, sum(hf.x)
FROM starjoin_eager_hf AS hf JOIN starjoin_eager_h2 AS h2 ON hf.d2 = h2.id
                             JOIN starjoin_eager_h3 AS h3 ON hf.d3 = h3.id
                             JOIN starjoin_eager_h1 AS h1 ON hf.d1 = h1.id
GROUP BY h1.v;
                                                QUERY PLAN                                                 
